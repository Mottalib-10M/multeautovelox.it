---
/**
 * Accueil d'une langue (page pilier, RECETTE §5) : la question d'abord, « quanto pago per questa
 * velocità ? », donc le calculateur en tête ; puis le bloc citable replié, le registre MIT en quatre
 * chiffres, les cinq rubriques et le texte. Texte dans src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import VelocitaTool from './mv/VelocitaTool';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, type Locale } from '../i18n/routes';
import { navCategories } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { AUTHOR_NAME } from '../data/site-config';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const path = route('home', lang);
const parts = x.body(H).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['cds142', 'reg345', 'cds202', 'cds203', 'cds195', 'tabella', 'cds126bis', 'mitVelox', 'mitNews', 'istat'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const it = lang === 'it';
const I = H.S.italia;
const tiles = [
  { v: H.num(I.totale), l: it ? 'apparecchi nel registro MIT' : 'devices in the MIT register' },
  { v: H.num(I.comuni), l: it ? 'comuni che ne dichiarano almeno uno' : 'comuni declaring at least one' },
  { v: H.num(I.categorie.velocita_media), l: it ? 'misuratori di velocità media' : 'average-speed systems' },
  { v: H.num(I.polizia_stradale), l: it ? 'della Polizia Stradale' : 'run by the Polizia Stradale' },
];
const cats = navCategories(lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-3 border-l-4 border-accent-600 pl-4">
    <h1 style="hyphens: manual" class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 max-sm:text-[0.95rem] sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil><VelocitaTool client:load lang={lang} id="home" methodHref={route('method', lang)} /></div>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={2} class="mt-4" />
  <p class="mt-3 text-sm text-navy-600">{it ? 'Di' : 'By'} <a href={route('about', lang)} class="underline">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline">{it ? 'Metodo e fonti' : 'Method and sources'}</a> · <a href={route('elenco-autovelox', lang)} class="underline">{it ? 'Autovelox del tuo comune' : 'Cameras in your comune'}</a></p>
  <div data-chrome class="mt-8 rounded-xl bg-navy-900 p-4 text-white sm:p-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-200">{it ? `Registro nazionale degli autovelox, versione del ${H.date(H.reg)}` : `National speed-camera register, version of ${H.date(H.reg)}`}</p>
    <div class="mt-3 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {tiles.map((t) => <div><p class="tabular-nums text-3xl font-bold">{t.v}</p><p class="text-sm text-navy-100">{t.l}</p></div>)}
    </div>
    <p class="mt-4 text-sm"><a href={route('autovelox-mappa', lang)} class="font-semibold text-white underline">{it ? 'Vedi la mappa per regione' : 'See the map by region'}</a> · <a href={route('autovelox-omologati', lang)} class="font-semibold text-white underline">{it ? 'Cerca un decreto di omologazione' : 'Look up an approval decree'}</a></p>
  </div>
  <nav data-chrome aria-label={it ? 'Argomenti' : 'Topics'} class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    {cats.map((c) => (
      <div class="rounded-lg border border-navy-200 p-3">
        <p class="font-semibold text-navy-900">{c.label}</p>
        <p class="mt-1 text-sm leading-relaxed">{c.links.slice(0, 4).map((k, i) => <>{i > 0 && ' · '}<a href={k.href} class="text-accent-700 hover:underline">{k.label}</a></>)}</p>
      </div>
    ))}
  </nav>
  <div class="prose prose-slate mt-8 max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div class="mini-bloc"><MiniSim client:load kind={p} lang={lang} /></div>)}
  </div>
</PageLayout>
