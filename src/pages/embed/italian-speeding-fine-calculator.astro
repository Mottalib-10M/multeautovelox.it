---
/** Embeddable page (iframe): the speeding calculator without navigation. noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import VelocitaTool from '../../components/mv/VelocitaTool';
import { SITE_URL } from '../../data/site-config';
import { licenzeHtml } from '../../i18n/licenze';
import { P } from '../../lib/engine/params';
import { displayDate } from '../../lib/format';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Italian speeding fine calculator – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <VelocitaTool client:load lang="en" id="embed" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">Multe e Autovelox</a> · Italian Highway Code, texts reread on {displayDate(P.retrieved_at, 'en-GB')}</p>
    <div class="mt-1 text-center text-xs text-navy-600 [&_a]:underline"><Fragment set:html={licenzeHtml('en')} /></div>
  </body>
</html>
